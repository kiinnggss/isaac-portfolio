// prisma/schema.prisma
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("pending") // pending | replied | flagged
  ipHash    String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  path      String?
  meta      String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}
